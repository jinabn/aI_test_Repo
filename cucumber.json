{
  "default": {
    "paths": ["features/**/*.feature"],
    "require": [
      "step-definitions/**/*.steps.ts",
      "step-definitions/hooks.ts"
    ],
    "requireModule": ["ts-node/register"],
    "format": [
      "@cucumber/pretty-formatter",
      "json:bdd-results/cucumber-report.json",
      "junit:bdd-results/junit-bdd.xml",
      "html:bdd-results/bdd-report.html"
    ],
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "publishQuiet": true,
    "parallel": 1
  },
  "smoke": {
    "paths": ["features/**/*.feature"],
    "require": [
      "step-definitions/**/*.steps.ts",
      "step-definitions/hooks.ts"
    ],
    "requireModule": ["ts-node/register"],
    "tags": "@smoke",
    "format": ["@cucumber/pretty-formatter"],
    "publishQuiet": true
  }
}
