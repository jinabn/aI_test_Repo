# ============================================================
# Dynamics CRM Credentials
# ============================================================
DYN365_BaseURL=https://login.microsoftonline.com/
DYN365_TEST_ORG_URL=https://nthcrm-test.crm.dynamics.com/main.aspx?appid=
DYN365_USER_NAME=your-user@domain.onmicrosoft.com
DYN365_TEST_USER_NAME=testuser@domain.onmicrosoft.com
DYN365_PASSWORD=your_password
DYN365_TEST_PASSWORD=your_test_password

# ============================================================
# Inventory Management App
# ============================================================
INVENTORY_MGMT_URL=https://your-inventory-app-url
INVENTORY_MGMT_USER_NAME=your-user@domain.onmicrosoft.com
INVENTORY_MGMT_PASSWORD=your_password

# ============================================================
# Azure DevOps Configuration
# ============================================================
AZURE_DEVOPS_ORG=https://dev.azure.com/YOUR_ORG
AZURE_DEVOPS_PROJECT=YOUR_PROJECT
AZURE_DEVOPS_PAT=YOUR_PERSONAL_ACCESS_TOKEN

# ============================================================
# OpenAI Configuration (for AI test case generation)
# ============================================================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o

# ============================================================
# Framework Settings
# ============================================================
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=30000
BASE_SCREENSHOT_DIR=test-results/screenshots
